{
  "name": "harmonia-player",
  "main": "expo-router/entry",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "lint": "tsc --noEmit",
    "server": "node server/index.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild:android": "EXPO_NO_TELEMETRY=1 expo prebuild --platform android --no-install",
    "build:apk": "bash scripts/build-apk.sh",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "ajv": "^8.20.0",
    "cors": "^2.8.5",
    "expo": "^55.0.31",
    "expo-asset": "~55.0.20",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-video": "~55.0.21",
    "express": "^4.22.3",
    "query-string": "^7.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.0",
