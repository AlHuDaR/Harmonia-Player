    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
