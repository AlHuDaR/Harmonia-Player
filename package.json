    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "vite": "^8.3.3",
